# Route66 环境变量示例。复制为 .env 后按需修改;不配置的项目有安全默认值。
# Go 服务本身不读 .env 文件,需要 shell 加载:set -a; source .env; set +a

# --- 基础 ---
# 用户端监听端口(默认 7800)
PORT=7800
# 管理台端口;留空 = 不启用管理台
ADMIN_PORT=7801

# --- 距离来源(默认 Valhalla,自托管、零 key) ---
# valhalla | amap(遗留,不推荐)
DISTANCE_SOURCE=valhalla
# Valhalla 服务地址(docker compose 里的 valhalla 服务)
VALHALLA_URL=http://localhost:8002
# 地名搜索来源:photon(默认,公共实例在大陆网络可达)| nominatim
SEARCH_SOURCE=photon
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- 高德(可选,仅 DISTANCE_SOURCE=amap 或公交模式需要) ---
# Web服务 平台 key:后端距离 / 搜索 / 路网轨迹(REST)
AMAP_KEY=你的Web服务平台key
# 以下两项是 JS API key 及其安全密钥的兜底值;配了 PostgreSQL 后在管理台配置优先
AMAP_JS_KEY=你的Web端JSAPIkey
AMAP_JS_CODE=该key的安全密钥

# --- Redis(可选;不配则降级进程内缓存) ---
REDIS_ADDR=localhost:6379

# --- PostgreSQL(可选;配置后启用登录墙 / 异步任务 / 管理台) ---
PG_DSN=postgres://routeplanner:routeplanner@localhost:5432/routeplanner?sslmode=disable
# 管理员种子账号(启用认证时,启动时自动创建)
ADMIN_USER=admin
ADMIN_PASSWORD=改成你自己的

# --- LLM(可选;仅 agent 功能需要,任选 OpenAI 兼容服务) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
