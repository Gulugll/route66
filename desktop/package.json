{
  "name": "routeplanner-desktop",
  "productName": "RoutePlanner",
  "version": "1.0.0",
  "description": "Route Planner desktop shell (wraps the web UI served by the Go backend)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . RoutePlanner --platform=darwin --arch=arm64 --out=dist --overwrite --prune --ignore=dist"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "@electron/packager": "^18.0.0"
  }
}
